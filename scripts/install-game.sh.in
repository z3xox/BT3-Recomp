#!/usr/bin/env bash
# Install Dragon Ball Budokai Tenkaichi 3 (Recompiled) into this user's home:
# copies the portable tree to ~/.local/share/bt3-recomp and registers a
# launcher entry (with the game icon) in the application menu.
set -euo pipefail

SRC="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
BASE="${XDG_DATA_HOME:-$HOME/.local/share}"
DEST="$BASE/bt3-recomp"

echo "== installing to $DEST"
mkdir -p "$DEST"

cp -a "$SRC"/Launcher "$SRC"/bt3-runner "$SRC"/assets "$DEST"/

# no game data here: the launcher's install wizard extracts it from the user's
# own ISO into $DEST/data on first run. Existing $DEST/data is left untouched.

# savedata: keep an existing install's saves/settings
if [[ -d "$SRC/savedata" ]]; then
    if [[ ! -d "$DEST/savedata" ]]; then
        cp -a "$SRC/savedata" "$DEST/"
    else
        echo "  keeping existing $DEST/savedata"
    fi
fi
# [fps60] the pacing table lives in the save folder and is not user data: refresh
# it even on reinstall, when an existing savedata/ is otherwise kept.
if [[ -f "$SRC/savedata/fps60_sites.txt" ]]; then
    mkdir -p "$DEST/savedata"
    cp -a "$SRC/savedata/fps60_sites.txt" "$DEST/savedata/"
fi

# launcher wrapper
WRAP="$BASE/bt3-launcher.sh"
cat > "$WRAP" <<EOF
#!/usr/bin/env bash
set -euo pipefail
cd "$DEST"
export LD_LIBRARY_PATH="\$PWD/assets/lib"
export QT_PLUGIN_PATH="\$PWD/assets/lib/qt6/plugins"
export PS2X_EXEDIR="\$PWD"
exec ./Launcher "\$@"
EOF
chmod +x "$WRAP"

# icon + desktop entry
mkdir -p "$BASE/icons" "$BASE/applications"
cp -f "$DEST/assets/icon.png" "$BASE/icons/bt3.png"
cat > "$BASE/applications/Dragon-Ball-Budokai-Tenkaichi-3.desktop" <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Dragon Ball Budokai Tenkaichi 3
Comment=Play Dragon Ball Budokai Tenkaichi 3 (recompiled)
Exec=$WRAP
Icon=$BASE/icons/bt3.png
Terminal=false
Categories=Game;
EOF

echo
echo "Installed:"
echo "  game:      $DEST"
echo "  launcher:  $WRAP"
echo "  menu:      $BASE/applications/Dragon-Ball-Budokai-Tenkaichi-3.desktop"
echo "Run it from the application menu, or:  \"$WRAP\""
echo "You can now delete the portable folder:  \"$SRC\""