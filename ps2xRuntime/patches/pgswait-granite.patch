diff --git a/vulkan/fence.cpp b/vulkan/fence.cpp
index b6900cf4..7b5b307b 100644
--- a/vulkan/fence.cpp
+++ b/vulkan/fence.cpp
@@ -22,6 +22,59 @@
 
 #include "fence.hpp"
 #include "device.hpp"
+#include <atomic>
+#include <chrono>
+
+// [pgswait] How much wall time is spent BLOCKED on the GPU inside paraLLEl-GS, as opposed to
+// doing CPU parse work. gif_transfer costs ~10 ms/swap on the i5-12400 and we do not know which
+// it is; perf's cpu-clock cannot see off-CPU blocking. Read by ps2x_pgs / the dump replayer.
+// NOTE: wait_timeout(0) is a POLL (vkGetSemaphoreCounterValue), not a wait -- it is what the
+// fenced readback ring uses to never block -- so it is deliberately NOT counted.
+std::atomic<unsigned long long> g_pgsFenceWaitNs{0};
+std::atomic<unsigned long long> g_pgsFenceWaitCalls{0};
+std::atomic<unsigned long long> g_pgsFenceWaitBlocked{0};
+
+// [pgswait2] PER-THREAD attribution of GPU blocking. The totals alone cannot say WHICH thread
+// stalls: gif_transfer runs on GsThread, onSwap on the GameThread, and they share one mutex, so
+// 484 ms/s of blocking means very different things depending on where it lands. Tag set once per
+// thread by the runtime (ps2x_pgs_set_thread_tag).
+//   tag: 0 = other, 1 = GameThread, 2 = KickWorker, 3 = GsThread
+//   fam: 0 = fence, 1 = timeline semaphore, 2 = frame context
+thread_local int g_pgsThreadTag = 0;
+std::atomic<unsigned long long> g_pgsWaitNsBy[4][3];
+std::atomic<unsigned long long> g_pgsWaitCallsBy[4][3];
+extern "C" void ps2x_pgs_set_thread_tag(int tag) { g_pgsThreadTag = (tag >= 0 && tag < 4) ? tag : 0; }
+extern "C" void ps2x_pgs_set_thread_tag_if_unset(int tag)
+{   // [pgswait2] onSwap runs on whichever thread called swapFrame; it must not relabel a thread
+	if (g_pgsThreadTag == 0) ps2x_pgs_set_thread_tag(tag);
+}
+void pgsWaitNote(int fam, unsigned long long ns)
+{
+	const int t = (g_pgsThreadTag >= 0 && g_pgsThreadTag < 4) ? g_pgsThreadTag : 0;
+	g_pgsWaitNsBy[t][fam].fetch_add(ns, std::memory_order_relaxed);
+	g_pgsWaitCallsBy[t][fam].fetch_add(1, std::memory_order_relaxed);
+}
+
+namespace
+{
+struct PgsWaitTimer
+{
+	std::chrono::steady_clock::time_point t0;
+	bool on;
+	explicit PgsWaitTimer(bool on_) : t0(std::chrono::steady_clock::now()), on(on_) {}
+	~PgsWaitTimer()
+	{
+		if (!on) return;
+		const auto ns = (unsigned long long) std::chrono::duration_cast<std::chrono::nanoseconds>(
+				std::chrono::steady_clock::now() - t0).count();
+		g_pgsFenceWaitNs.fetch_add(ns, std::memory_order_relaxed);
+		g_pgsFenceWaitCalls.fetch_add(1, std::memory_order_relaxed);
+		if (ns > 50000ull) g_pgsFenceWaitBlocked.fetch_add(1, std::memory_order_relaxed);
+		pgsWaitNote(0, ns);   // [pgswait2]
+	}
+};
+}
