+// [sspages] Restrict WHICH VRAM pages may be promoted to super-sampled textures.
+// Upstream promotes any page PageTracker flagged as a framebuffer write, which in BT3 is the whole
+// post-process chain; [sscensus] shows the cost is ~62% one page (the Z/mask page) and 13% the
+// outline page. PS2X_PGS_SSPAGES=<comma-separated pages> (e.g. "336", or "336,224") limits promotion
+// to those pages; unset = upstream behaviour; a value with no digits (e.g. "none") promotes nothing.
+// This is NOT the same as super_sampled_textures=false, which also changes the render-pass
+// single-sample demotion gate -- this knob isolates the texture promotion alone.
+struct SsPageAllow
+{
+	bool enabled;
+	bool page[512];
+};
+
+const SsPageAllow &ss_page_allow()
+{
+	static const SsPageAllow a = []() {
+		SsPageAllow s = {};
+		const char *v = getenv("PS2X_PGS_SSPAGES");
+		if (v && v[0])
+		{
+			s.enabled = true;
+			for (const char *p = v; *p; )
+			{
+				if (*p < '0' || *p > '9') { ++p; continue; }
+				unsigned n = 0;
+				while (*p >= '0' && *p <= '9') { n = n * 10u + unsigned(*p - '0'); ++p; }
+				s.page[n & 511u] = true;
+			}
+		}
+		return s;
+	}();
+	return a;
+}
+
+inline bool ss_page_allowed(uint32_t base_page)
+{
+	const SsPageAllow &a = ss_page_allow();
+	return !a.enabled || a.page[base_page & 511u];
+}
+}
