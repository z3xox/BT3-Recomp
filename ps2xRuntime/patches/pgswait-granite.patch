+std::atomic<unsigned long long> g_pgsIdleNs{0};
+std::atomic<unsigned long long> g_pgsIdleCalls{0};
+// [pgswait] Device::PerFrame::wait = Granite's per-frame-context wait: the CPU blocks here when it
+// begins a new frame while the GPU is still on an older one. THIS is where frame pacing blocks, and
+// FenceHolder never sees it. device.cpp:2688 polls it with timeout==0, so only timeout!=0 is counted.
+std::atomic<unsigned long long> g_pgsFrameWaitNs{0};
+std::atomic<unsigned long long> g_pgsFrameWaitCalls{0};
