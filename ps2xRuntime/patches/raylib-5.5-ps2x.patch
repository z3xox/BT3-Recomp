+/* returns 1 when the MVP for this program must be (re)sent */
+static int rlVbRingMvpDirty(unsigned int prog, const float *m)
+{
+    if (rlVbRingNoCache() & 1) return 1;
+    for (int i = 0; i < g_vbr.mvpN; i++)
+    {
+        if (g_vbr.mvpProg[i] != prog) continue;
+        if (memcmp(g_vbr.mvp[i], m, 16*sizeof(float)) == 0) { g_rlglVbRingMvpSkips++; return 0; }
+        memcpy(g_vbr.mvp[i], m, 16*sizeof(float));
+        return 1;
+    }
+    if (g_vbr.mvpN < 16) { g_vbr.mvpProg[g_vbr.mvpN] = prog; memcpy(g_vbr.mvp[g_vbr.mvpN], m, 16*sizeof(float)); g_vbr.mvpN++; }
+    return 1;
+}
+static int rlVbRingConstDirty(unsigned int prog)
+{
+    if (rlVbRingNoCache() & 2) return 1;
+    for (int i = 0; i < g_vbr.constN; i++) if (g_vbr.constProg[i] == prog) return 0;
+    if (g_vbr.constN < 16) g_vbr.constProg[g_vbr.constN++] = prog;
+    return 1;
+}
+/* a (re)linked or deleted program has fresh uniforms: drop it from both caches (rlLoadShaderProgram / rlUnloadShaderProgram call this) */
