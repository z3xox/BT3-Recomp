+    const char *env = getenv("PS2X_VBRING");
+    if (env && env[0] == '0') { TRACELOG(RL_LOG_INFO, "RLGL: [vbring] disabled by PS2X_VBRING=0"); return; }
+    if (!RLGL.ExtSupported.vao || !glMapBufferRange || !glFenceSync || !glClientWaitSync || !glDeleteSync
+#if !defined(__APPLE__)
+        || !glBufferStorage
+#endif
