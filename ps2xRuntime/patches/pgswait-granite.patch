+
+namespace
+{
+struct PgsFrameTimer
+{
+	std::chrono::steady_clock::time_point t0;
+	bool on;
+	explicit PgsFrameTimer(bool on_) : t0(std::chrono::steady_clock::now()), on(on_) {}
+	~PgsFrameTimer()
+	{
+		if (!on) return;
+		const auto ns = (unsigned long long) std::chrono::duration_cast<std::chrono::nanoseconds>(
+				std::chrono::steady_clock::now() - t0).count();
+		g_pgsFrameWaitNs.fetch_add(ns, std::memory_order_relaxed);
+		g_pgsFrameWaitCalls.fetch_add(1, std::memory_order_relaxed);
+		if (ns > 50000ull) g_pgsFrameWaitBlocked.fetch_add(1, std::memory_order_relaxed);
+		pgsWaitNote(2, ns);   // [pgswait2]
+	}
+};
+
+struct PgsIdleTimer
+{
+	std::chrono::steady_clock::time_point t0{std::chrono::steady_clock::now()};
+	~PgsIdleTimer()
+	{
+		g_pgsIdleNs.fetch_add((unsigned long long) std::chrono::duration_cast<std::chrono::nanoseconds>(
+				std::chrono::steady_clock::now() - t0).count(), std::memory_order_relaxed);
+		g_pgsIdleCalls.fetch_add(1, std::memory_order_relaxed);
+	}
+};
+}
