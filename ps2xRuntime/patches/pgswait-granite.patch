+	{   // [pgswait] PS2X_PGS_FRAMECTX=<n>, default 2 = upstream behaviour.
+		// Granite double-buffers CPU/GPU, so the CPU cannot begin frame N+2 until the GPU retires N.
+		// That is exactly what blocks in Device::PerFrame::wait -- measured ~2.9 ms/swap in a BT3
+		// fight and INVARIANT to the frame cap (2.76 ms at 30 fps vs 2.90 at 60), i.e. the CPU waits
+		// because the GPU makes it, not because it has slack. 3 buys a frame of run-ahead.
+		const char *v = getenv("PS2X_PGS_FRAMECTX");
+		unsigned n = (v && v[0]) ? unsigned(atoi(v)) : 2u;
+		if (n < 2u) n = 2u;
+		if (n > 4u) n = 4u;
+		LOGI("[pgswait] frame contexts = %u (PS2X_PGS_FRAMECTX, default 2)\n", n);
+		init_frame_contexts(n);
+	}
 
 	managers.memory.init(this);
 	managers.semaphore.init(this);
