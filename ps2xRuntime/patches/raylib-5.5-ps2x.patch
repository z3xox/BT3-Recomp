+    {
+        TRACELOG(RL_LOG_INFO, "RLGL: [vbring] not available (vao=%d bufferStorage=%d) - SubData path", RLGL.ExtSupported.vao, glBufferStorage != NULL);
+        return;
+    }
+    int ringVerts = RL_VBRING_VERTS;
+    if (env && env[0] != '0' && atoi(env) > 1) ringVerts = atoi(env);
+    ringVerts = (ringVerts + 3) & ~3;
+    const int maxBatchVerts = bufferElements*4;
+    if (ringVerts < maxBatchVerts*RL_VBRING_SEGS) ringVerts = maxBatchVerts*RL_VBRING_SEGS;
+    ringVerts = (ringVerts/RL_VBRING_SEGS + 3) & ~3;   /* segment size, 4-aligned */
+    g_vbr.segVerts = ringVerts;
+    g_vbr.ringVerts = ringVerts*RL_VBRING_SEGS;
