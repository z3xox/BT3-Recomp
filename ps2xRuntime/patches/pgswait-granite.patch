 #include "quirks.hpp"
 #include "timer.hpp"
 #include <algorithm>
+#include <atomic>
+#include <chrono>
+
+// [pgswait] full-device stalls (live ssaa re-init, teardown). See fence.cpp.
+std::atomic<unsigned long long> g_pgsIdleNs{0};
+std::atomic<unsigned long long> g_pgsIdleCalls{0};
+// [pgswait] Device::PerFrame::wait = Granite's per-frame-context wait: the CPU blocks here when it
+// begins a new frame while the GPU is still on an older one. THIS is where frame pacing blocks, and
+// FenceHolder never sees it. device.cpp:2688 polls it with timeout==0, so only timeout!=0 is counted.
+std::atomic<unsigned long long> g_pgsFrameWaitNs{0};
+std::atomic<unsigned long long> g_pgsFrameWaitCalls{0};
+std::atomic<unsigned long long> g_pgsFrameWaitBlocked{0};
+std::atomic<unsigned long long> g_pgsQueueIdleCalls{0};
+
+namespace
+{
+struct PgsFrameTimer
+{
+	std::chrono::steady_clock::time_point t0;
+	bool on;
+	explicit PgsFrameTimer(bool on_) : t0(std::chrono::steady_clock::now()), on(on_) {}
+	~PgsFrameTimer()
+	{
+		if (!on) return;
+		const auto ns = (unsigned long long) std::chrono::duration_cast<std::chrono::nanoseconds>(
+				std::chrono::steady_clock::now() - t0).count();
+		g_pgsFrameWaitNs.fetch_add(ns, std::memory_order_relaxed);
+		g_pgsFrameWaitCalls.fetch_add(1, std::memory_order_relaxed);
+		if (ns > 50000ull) g_pgsFrameWaitBlocked.fetch_add(1, std::memory_order_relaxed);
+	}
+};
+
+struct PgsIdleTimer
+{
+	std::chrono::steady_clock::time_point t0{std::chrono::steady_clock::now()};
+	~PgsIdleTimer()
+	{
+		g_pgsIdleNs.fetch_add((unsigned long long) std::chrono::duration_cast<std::chrono::nanoseconds>(
+				std::chrono::steady_clock::now() - t0).count(), std::memory_order_relaxed);
+		g_pgsIdleCalls.fetch_add(1, std::memory_order_relaxed);
+	}
+};
+}
