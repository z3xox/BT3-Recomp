+        glBufferData(GL_ELEMENT_ARRAY_BUFFER, (GLsizeiptr)(quads*6*sizeof(unsigned int)), idx, GL_STATIC_DRAW);
+        RL_FREE(idx);
+        if (glGetError() != GL_NO_ERROR) ok = 0;
+    }
+    glBindVertexArray(0);
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
+    if (!ok)
+    {
+        TRACELOG(RL_LOG_WARNING, "RLGL: [vbring] setup failed - SubData path");
+        return;
+    }
+    g_vbr.cursor = 0; g_vbr.curSeg = 0; g_vbr.lastFencedSeg = -1;
+    g_vbr.on = 1; g_rlglVbRingOn = 1;
+    TRACELOG(RL_LOG_INFO, "RLGL: [vbring] %s vertex ring on: %d vertices (%d segments of %d), %.1f MB",
+             g_vbr.persistent ? "persistent" : "mapped", g_vbr.ringVerts, RL_VBRING_SEGS, g_vbr.segVerts,
+             (bytes[0] + bytes[1] + bytes[2] + bytes[3])/1048576.0);
+}
