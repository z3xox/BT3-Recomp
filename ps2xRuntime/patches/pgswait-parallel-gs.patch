+// [sscensus] Diagnostic (PS2X_PGS_SSCENSUS=1, default off): which VRAM pages get promoted to
+// super-sampled textures, and what that promotion costs. The promotion is decided in
+// GSInterface (desc.samples = 1 << (rate_x+rate_y)) gated on PAGE_STATE_MAY_SUPER_SAMPLE_BIT,
+// which PageTracker sets on EVERY page written as a framebuffer. This census answers whether the
+// cost is concentrated in a few render-target pages (so the qualifier could be narrowed to them)
+// or spread across every RT-reading effect (in which case the cost IS the per-sample quality).
+// Counted here, at the cache-miss path that actually allocates and uploads.
+namespace
+{
+struct SsCensusPage
+{
+	uint64_t uploads, ssUploads, texels, ssTexels;
+	uint32_t maxSamples, psm;
+};
+
+struct SsCensus
+{
+	bool enabled;
+	double interval;
+	SsCensusPage pages[512];
+	uint64_t uploads, ssUploads, replacedUploads, texels, ssTexels;
+	std::chrono::steady_clock::time_point last;
+};
+
+SsCensus &ss_census()
+{
+	// getenv cached: an uncached getenv in a hot path has been a measured regression here before.
+	static SsCensus c = []() {
+		SsCensus s = {};
+		const char *v = getenv("PS2X_PGS_SSCENSUS");
+		s.enabled = v && v[0] && v[0] != '0';
+		// The value is the print interval in seconds (PS2X_PGS_SSCENSUS=5); "1" stays a valid
+		// enable and simply means a 1 s interval, so short offline replays still emit a line.
+		const double iv = v ? atof(v) : 0.0;
+		s.interval = iv >= 0.5 ? iv : 5.0;
+		s.last = std::chrono::steady_clock::now();
+		return s;
+	}();
+	return c;
+}
+
+void ss_census_record(uint32_t tbp0, uint32_t psm, uint32_t width, uint32_t height,
+                      uint32_t samples, bool replaced)
+{
+	SsCensus &c = ss_census();
+	if (!c.enabled)
+		return;
+
+	// Mirrors the allocator: info.layers = desc.samples, +1 when super-sampled.
+	const uint32_t layers = samples > 1 ? samples + 1u : 1u;
+	const uint64_t texels = uint64_t(width) * height * layers;
+	const uint32_t page = (tbp0 / 32u) & 511u;
+	SsCensusPage &p = c.pages[page];
+
+	p.uploads++;
+	p.texels += texels;
+	p.psm = psm;
+	c.uploads++;
+	c.texels += texels;
+	if (replaced)
+		c.replacedUploads++;
+	if (samples > 1)
+	{
+		p.ssUploads++;
+		p.ssTexels += texels;
+		if (samples > p.maxSamples)
+			p.maxSamples = samples;
+		c.ssUploads++;
+		c.ssTexels += texels;
+	}
+
+	const auto now = std::chrono::steady_clock::now();
+	const double dt = std::chrono::duration<double>(now - c.last).count();
+	if (dt < c.interval)
+		return;
+
+	// Rank by super-sampled texel cost: that is exactly what a narrower qualifier would remove.
+	unsigned order[512], n = 0;
+	for (unsigned i = 0; i < 512; i++)
+		if (c.pages[i].ssUploads)
+			order[n++] = i;
+	std::sort(order, order + n, [&](unsigned x, unsigned y) {
+		return c.pages[x].ssTexels > c.pages[y].ssTexels;
+	});
+
+	fprintf(stderr,
+	        "[sscensus] %.1fs: uploads %.0f/s (ss %.0f/s = %.1f%%, replaced %.0f/s) | "
+	        "texels %.1f MT/s (ss %.1f MT/s = %.1f%%) | ss pages %u",
+	        dt, double(c.uploads) / dt, double(c.ssUploads) / dt,
+	        c.uploads ? 100.0 * double(c.ssUploads) / double(c.uploads) : 0.0,
+	        double(c.replacedUploads) / dt,
+	        double(c.texels) / dt / 1e6, double(c.ssTexels) / dt / 1e6,
+	        c.texels ? 100.0 * double(c.ssTexels) / double(c.texels) : 0.0, n);
+
+	for (unsigned i = 0; i < n && i < 8; i++)
+	{
+		const SsCensusPage &q = c.pages[order[i]];
+		fprintf(stderr, " | pg%u psm%u x%u %.0f/s %.2fMT/s (%.0f%%)",
+		        order[i], q.psm, q.maxSamples, double(q.ssUploads) / dt,
+		        double(q.ssTexels) / dt / 1e6,
+		        c.ssTexels ? 100.0 * double(q.ssTexels) / double(c.ssTexels) : 0.0);
+	}
+	fprintf(stderr, "\n");
+	fflush(stderr);
+
+	for (unsigned i = 0; i < 512; i++)
+		c.pages[i] = {};
+	c.uploads = c.ssUploads = c.replacedUploads = c.texels = c.ssTexels = 0;
+	c.last = now;
+}
+}
