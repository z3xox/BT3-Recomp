diff --git a/gs/gs_renderer.cpp b/gs/gs_renderer.cpp
index 29452b2..56586d9 100644
--- a/gs/gs_renderer.cpp
+++ b/gs/gs_renderer.cpp
@@ -4,6 +4,9 @@
 // SPDX-License-Identifier: LGPL-3.0+
 
 #include "gs_renderer.hpp"
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
 #include "logging.hpp"
 #include "gs_interface.hpp"
 #include "gs_registers_debug.hpp"
@@ -1113,6 +1116,9 @@ void GSRenderer::flush_qword_clears()
 	qword_clears.clear();
 }
 
+// [gcframe] diagnostics: how many flush_submit calls per frame, and how many are real boundaries.
+std::atomic<unsigned long long> g_pgsFlushSubmits{0}, g_pgsFlushBoundary{0};
+
 void GSRenderer::flush_submit(uint64_t value)
 {
 	if (!device)
@@ -1212,7 +1218,26 @@ void GSRenderer::flush_submit(uint64_t value)
 
 	// If we have a timeline trace, we'd like it to be somewhat readable.
 	// Only do garbage collection at frame boundaries.
-	if (!device->get_system_handles().timeline_trace_file)
+	//
+	// [gcframe] ...except flush_submit is NOT a frame boundary in this integration. It is called
+	// ~7.5 times per frame -- once from GSInterface::flush() (the real boundary, from our onSwap)
+	// and the rest from FlushReason::HostAccess sync points, where the CPU needs VRAM the GPU may
+	// still be writing. Each of those also advanced the frame-context ring, and every advance waits
+	// in Device::PerFrame::wait for the context it reuses. Measured on a 3070 Ti at ssaa=8: 7.5
+	// advances/frame, ~1.6 of them blocking, 4.8 ms/frame of pure waiting against a GPU only 59%
+	// busy. Deepening the ring (16 -> 32) did not help, because a deeper ring just means more
+	// deferred destruction per advance.
+	// PS2X_PGS_GCFRAME=1 advances only on the real frame boundary.
+	g_pgsFlushSubmits.fetch_add(1, std::memory_order_relaxed);
+	if (frame_boundary_flush)
+		g_pgsFlushBoundary.fetch_add(1, std::memory_order_relaxed);
+	static const bool s_gcframe = [](){ const char *v = getenv("PS2X_PGS_GCFRAME");
+		const bool on = v && v[0] && v[0] != '0';
+		fprintf(stderr, "[gcframe] PS2X_PGS_GCFRAME=%d (1 = advance the frame context only at frame boundaries)\n", on ? 1 : 0);
+		return on; }();
+	const bool advance = !s_gcframe || frame_boundary_flush;
+	frame_boundary_flush = false;
+	if (!device->get_system_handles().timeline_trace_file && advance)
 		device->next_frame_context();
 
 	log_timestamps();
